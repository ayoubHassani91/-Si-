---
import { MessageCircle, Phone, Send, Copy, Check, FileText, ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import { t, asset, whatsappHref, POLES, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const f = c.form;
// Clé d'accès Web3Forms : publique par nature (elle ne permet que d'envoyer vers la boîte de l'agence).
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY || '52e58672-0a4e-4654-9cce-00d897743f18';
---
<Base lang={lang} title={c.metaTitle} description={c.metaDescription} current="contact">
  <section class="tete">
    <div class="conteneur tete-grille">
      <div>
        <h1 class="titre-1 max-w-[14ch]" data-titre>{c.title}</h1>
        <p class="chapo mt-6 max-w-[44ch]" data-reveal>{c.lead}</p>
      </div>
      <!-- Motion Blender : une conversation, « vous écrivez, on répond ». -->
      <div class="tete-media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster={asset('/motion/message.webp')} data-motion-contact>
          <source src={asset('/motion/message.webm')} type="video/webm" />
          <source src={asset('/motion/message.mp4')} type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="canaux" aria-labelledby="canaux-titre">
    <div class="conteneur">
      <h2 id="canaux-titre" class="titre-3" data-reveal>{c.channelsTitle}</h2>
      <ul class="canaux-grille">
        <li class="canal" data-reveal>
          <span class="canal-icone"><MessageCircle size={26} stroke-width={1.75} aria-hidden="true" /></span>
          <h3 class="canal-titre">{c.channels.wa.title}</h3>
          <p class="text-encre-douce">{c.channels.wa.text}</p>
          <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="canal-action canal-lien">{c.channels.wa.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" /></a>
        </li>
        <li class="canal" data-reveal data-reveal-delay="0.06">
          <span class="canal-icone"><Phone size={26} stroke-width={1.75} aria-hidden="true" /></span>
          <h3 class="canal-titre">{c.channels.phone.title}</h3>
          <p class="text-encre-douce"><a href="tel:+33652277787" dir="ltr" class="numero">06 52 27 77 87</a></p>
          <div class="canal-action canal-duo">
            <a href="tel:+33652277787" class="canal-bouton canal-plein">{c.channels.phone.cta}</a>
            <button type="button" class="canal-bouton canal-copie" data-copie="+33652277787" data-copie-ok={c.channels.phone.copied}>
              <span class="copie-icones" aria-hidden="true"><Copy size={16} stroke-width={1.75} class="i-copie" /><Check size={16} stroke-width={1.75} class="i-ok" /></span>
              <span data-copie-label>{c.channels.phone.copy}</span>
            </button>
          </div>
          <p class="sr-only" role="status" aria-live="polite" data-copie-statut></p>
        </li>
        <li class="canal" data-reveal data-reveal-delay="0.12">
          <span class="canal-icone"><FileText size={26} stroke-width={1.75} aria-hidden="true" /></span>
          <h3 class="canal-titre">{c.channels.form.title}</h3>
          <p class="text-encre-douce">{c.channels.form.text}</p>
          <a href="#formulaire" class="canal-action canal-lien">{c.channels.form.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche fleche-bas" aria-hidden="true" /></a>
        </li>
      </ul>
    </div>
  </section>

  <section id="formulaire" class="zone-form">
    <div class="conteneur">
      <form class="formulaire carte" data-contact data-key={key} novalidate
        data-msg-required={f.errors.required} data-msg-email={f.errors.email} data-msg-message={f.errors.message}
        data-msg-sending={f.sending} data-msg-success={f.success} data-msg-error={f.error} data-msg-nokey={f.notConfigured}>
        <input type="hidden" name="subject" value="Nouvelle demande depuis le site &si" />
        <input type="hidden" name="from_name" value="Site &si" />
        <input type="checkbox" name="botcheck" class="piege" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="champ">
          <label for="c-nom">{f.name}</label>
          <input id="c-nom" name="name" type="text" autocomplete="name" maxlength="120" required aria-describedby="c-nom-err" />
          <p class="erreur" id="c-nom-err" hidden></p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="champ">
            <label for="c-email">{f.email}</label>
            <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="200" required aria-describedby="c-email-err" dir="ltr" />
            <p class="erreur" id="c-email-err" hidden></p>
          </div>
          <div class="champ">
            <label for="c-tel">{f.phone} <span class="text-encre-douce">({f.optional})</span></label>
            <input id="c-tel" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" dir="ltr" />
          </div>
        </div>
        <fieldset class="champ">
          <legend>{f.poles}</legend>
          <p class="text-legende text-encre-douce">{f.polesHint}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {POLES.map((p) => (
              <label class="choix" data-pole={p}><input type="checkbox" name="poles" value={d.poles[p].name} data-pole-key={p} /><span>{d.poles[p].name}</span></label>
            ))}
            <label class="choix"><input type="checkbox" name="poles" value={f.unsure} /><span>{f.unsure}</span></label>
          </div>
        </fieldset>
        <div class="champ">
          <label for="c-msg">{f.message}</label>
          <textarea id="c-msg" name="message" rows="6" required minlength="20" maxlength="5000" placeholder={f.messagePlaceholder} aria-describedby="c-msg-err"></textarea>
          <div class="compteur" aria-hidden="true"><span class="compteur-barre" data-compteur-barre></span></div>
          <p class="compteur-texte" data-compteur data-tpl={c.counter} data-ok={c.counterOk}></p>
          <p class="erreur" id="c-msg-err" hidden></p>
        </div>
        <p class="text-legende text-encre-douce">{f.consent}</p>
        <button type="submit" class="btn btn-principal self-start" data-submit>
          <span data-submit-label>{f.submit}</span><Send size={18} stroke-width={1.75} class="fleche" aria-hidden="true" />
        </button>
        <p class="statut" role="status" aria-live="polite" data-status hidden></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .tete { padding-block: clamp(32px, 6vw, 72px) clamp(24px, 4vw, 40px); }
  .tete-grille { display: grid; gap: 16px; align-items: center; }
  @media (min-width: 1024px) { .tete-grille { grid-template-columns: 7fr 5fr; gap: 48px; } }
  .tete-media { aspect-ratio: 1; inline-size: min(64%, 260px); justify-self: center; }
  @media (min-width: 1024px) { .tete-media { inline-size: min(100%, 440px); } }
  .tete-media video { inline-size: 100%; block-size: 100%; object-fit: cover; mix-blend-mode: darken; }

  .canaux { padding-block: 8px clamp(48px, 7vw, 80px); }
  .canaux-grille { display: grid; gap: 12px; margin-block-start: 20px; }
  @media (min-width: 900px) { .canaux-grille { grid-template-columns: repeat(3, 1fr); } }
  .canal {
    position: relative; display: flex; flex-direction: column; gap: 8px; padding: 24px;
    border-radius: var(--radius-m); background: var(--color-surface); border: 1px solid var(--color-trait);
    transition: border-color 0.2s, transform 0.3s var(--ease-sortie);
  }
  .canal:hover { border-color: var(--color-encre); transform: translateY(-4px); }
  .canal-icone {
    display: grid; place-items: center; inline-size: 52px; block-size: 52px; margin-block-end: 8px;
    border-radius: var(--radius-s); background: var(--color-sable); transition: background-color 0.25s, transform 0.4s var(--ease-sortie);
  }
  .canal:hover .canal-icone { background: var(--color-corail); transform: rotate(-6deg); }
  .canal-titre { font-family: var(--font-display); font-weight: 700; font-size: 22px; }
  .numero { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--color-encre); text-decoration: none; }
  .canal-action { margin-block-start: auto; }
  .canal > p.text-encre-douce { margin-block-end: 12px; }
  .canal-lien {
    display: flex; align-items: center; justify-content: space-between; min-block-size: 48px; padding-inline: 16px;
    border-radius: 999px; background: var(--color-encre); color: var(--color-papier); font-weight: 500; text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .canal-lien::after { content: ""; position: absolute; inset: 0; }
  .canal:hover .canal-lien { background: var(--color-corail); color: var(--color-encre); }
  .canal-lien .fleche { transition: transform 0.25s var(--ease-sortie); }
  .canal:hover .canal-lien .fleche { transform: translateX(4px); }
  .canal:hover .canal-lien .fleche-bas { transform: rotate(90deg) translateX(4px); }
  :global(html[dir="rtl"]) .canal-lien .fleche { transform: scaleX(-1); }
  /* Téléphone : deux boutons de même hauteur que ceux des autres cartes, sur toute la largeur. */
  .canal-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .canal-bouton {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-block-size: 48px; padding-inline: 12px; white-space: nowrap;
    border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--color-encre); font-weight: 500; text-decoration: none; cursor: pointer;
    transition: background-color 0.2s, color 0.2s, scale 0.15s;
  }
  .canal-bouton:hover { background: var(--color-encre); color: var(--color-papier); }
  .canal-plein { background: var(--color-encre); color: var(--color-papier); box-shadow: none; }
  .canal-plein:hover { background: var(--color-corail); color: var(--color-encre); }
  .canal-bouton:active { scale: 0.96; }
  .copie-icones { position: relative; inline-size: 16px; block-size: 16px; }
  .copie-icones :global(svg) { position: absolute; inset: 0; transition: opacity 0.2s, transform 0.3s var(--ease-sortie); }
  .i-ok { opacity: 0; transform: scale(0.4); }
  .canal-copie[data-fait] .i-copie { opacity: 0; transform: scale(0.4); }
  .canal-copie[data-fait] .i-ok { opacity: 1; transform: none; color: var(--color-vert); }
  .canal-copie[data-fait]:hover .i-ok { color: #4fbfa6; }

  .zone-form { padding-block: 0 clamp(64px, 9vw, 112px); scroll-margin-block-start: 88px; }
  .zone-form .formulaire { max-inline-size: 820px; margin-inline: auto; }
  .compteur { block-size: 3px; border-radius: 2px; background: var(--color-trait); overflow: hidden; }
  .compteur-barre { display: block; block-size: 100%; inline-size: 100%; background: var(--color-corail); transform: scaleX(0); transform-origin: left; transition: transform 0.25s var(--ease-sortie), background-color 0.25s; }
  :global(html[dir="rtl"]) .compteur-barre { transform-origin: right; }
  .compteur-barre[data-ok] { background: var(--color-vert); }
  .compteur-texte { font-family: var(--font-mono); font-size: 12px; color: var(--color-encre-douce); }
  [data-submit][data-envoi] .fleche { animation: envol 0.9s var(--ease-sortie) infinite; }
  @keyframes envol { 0% { transform: translate(0, 0); opacity: 1; } 60% { transform: translate(14px, -10px); opacity: 0; } 61% { transform: translate(-10px, 8px); opacity: 0; } 100% { transform: translate(0, 0); opacity: 1; } }
  .statut[data-type="success"] { animation: succes 0.5s var(--ease-sortie); }
  @keyframes succes { from { transform: scale(0.96); opacity: 0; } }
  .formulaire { display: flex; flex-direction: column; gap: 24px; padding: clamp(24px, 4vw, 48px); }
  .champ { display: flex; flex-direction: column; gap: 8px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .champ label, .champ legend { font-weight: 500; }
  .champ input:not([type="checkbox"]), .champ textarea {
    inline-size: 100%;
    padding: 12px 16px;
    border-radius: var(--radius-s);
    border: 1px solid var(--color-trait);
    background: var(--color-papier);
    font: inherit;
  }
  .champ textarea { resize: vertical; }
  .champ [aria-invalid="true"] { border-color: var(--color-corail-texte); }
  .erreur, .statut[data-type="error"] {
    display: flex; gap: 6px; align-items: flex-start;
    color: var(--color-corail-texte); font-size: 14px; line-height: 20px;
  }
  /* Icônes Lucide (circle-alert / circle-check), trait 1.75, dessinées en masque pour hériter de la couleur. */
  .erreur::before, .statut[data-type="error"]::before, .statut[data-type="success"]::before {
    content: ""; flex: none; inline-size: 18px; block-size: 18px; margin-block-start: 1px;
    background: currentColor; -webkit-mask: var(--icone) center / contain no-repeat; mask: var(--icone) center / contain no-repeat;
  }
  .erreur, .statut[data-type="error"] { --icone: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='1.75'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Ccircle%20cx='12'%20cy='12'%20r='10'/%3E%3Cline%20x1='12'%20x2='12'%20y1='8'%20y2='12'/%3E%3Cline%20x1='12'%20x2='12.01'%20y1='16'%20y2='16'/%3E%3C/svg%3E"); }
  .statut[data-type="success"] { --icone: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='1.75'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Ccircle%20cx='12'%20cy='12'%20r='10'/%3E%3Cpath%20d='m9%2012%202%202%204-4'/%3E%3C/svg%3E"); }
  .statut { padding: 14px 16px; border-radius: var(--radius-s); }
  .statut[data-type="error"] { background: var(--color-corail-pale); }
  .statut[data-type="success"] { background: #e3f0ec; color: var(--color-vert); display: flex; gap: 8px; }

  .statut[data-type="info"] { background: var(--color-sable); }
  .choix { position: relative; cursor: pointer; }
  .choix input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .choix span {
    display: inline-flex; padding: 8px 14px; border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-trait); background: var(--color-papier); font-size: 14px;
  }
  .choix input:checked + span { background: var(--color-encre); color: var(--color-papier); box-shadow: none; }
  .choix input:focus-visible + span { outline: 2px solid var(--color-cobalt); outline-offset: 2px; }
  .piege { position: absolute; inline-size: 1px; block-size: 1px; margin: 0; opacity: 0; clip-path: inset(50%); pointer-events: none; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const copie = document.querySelector<HTMLButtonElement>('[data-copie]');
    copie?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(copie.dataset.copie!); } catch { return; }
      const lab = copie.querySelector<HTMLElement>('[data-copie-label]')!;
      const avant = lab.textContent;
      copie.setAttribute('data-fait', '');
      lab.textContent = copie.dataset.copieOk!;
      const st = document.querySelector<HTMLElement>('[data-copie-statut]');
      if (st) st.textContent = copie.dataset.copieOk!;
      setTimeout(() => { copie.removeAttribute('data-fait'); lab.textContent = avant; }, 2200);
    });
    const v = document.querySelector<HTMLVideoElement>('[data-motion-contact]');
    if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(([en]) => { en.isIntersecting ? v.play().catch(() => {}) : v.pause(); }).observe(v);
    }
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    if (!form) return;
    const msg = (k: string) => form.dataset[k] ?? '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const idle = label.textContent;

    // Pôle(s) reçu(s) d'une page pôle (?pole=…) ou d'un lien (?poles=a,b).
    const q = new URLSearchParams(location.search);
    const poles = [q.get('pole'), ...(q.get('poles') ?? '').split(',')].filter(Boolean);
    poles.forEach((p) => {
      const box = form.querySelector<HTMLInputElement>(`[data-pole-key="${p}"]`);
      if (box && !box.checked) box.click();
    });


    const setErr = (input: HTMLInputElement | HTMLTextAreaElement, text: string) => {
      const p = form.querySelector<HTMLElement>(`#${input.id}-err`);
      input.setAttribute('aria-invalid', text ? 'true' : 'false');
      if (p) { p.textContent = text; p.hidden = !text; }
    };
    const validate = (moveFocus = true) => {
      const name = form.elements.namedItem('name') as HTMLInputElement;
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const message = form.elements.namedItem('message') as HTMLTextAreaElement;
      setErr(name, name.value.trim() ? '' : msg('msgRequired'));
      setErr(email, !email.value.trim() ? msg('msgRequired') : /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim()) ? '' : msg('msgEmail'));
      setErr(message, message.value.trim().length >= 20 ? '' : message.value.trim() ? msg('msgMessage') : msg('msgRequired'));
      const bad = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      if (moveFocus) bad?.focus();
      return !bad;
    };
    const show = (type: 'success' | 'error' | 'info', text: string) => {
      status.dataset.type = type; status.textContent = text; status.hidden = false;
    };

    // Compteur du message : jauge corail jusqu'à 20 caractères, verte ensuite.
    const msgBox = form.elements.namedItem('message') as HTMLTextAreaElement;
    const barre = form.querySelector<HTMLElement>('[data-compteur-barre]')!;
    const compteur = form.querySelector<HTMLElement>('[data-compteur]')!;
    const majCompteur = () => {
      const n = msgBox.value.trim().length;
      barre.style.transform = `scaleX(${Math.min(n / 20, 1)})`;
      barre.toggleAttribute('data-ok', n >= 20);
      compteur.textContent = n >= 20 ? compteur.dataset.ok! : compteur.dataset.tpl!.replace('{n}', String(n));
    };
    msgBox.addEventListener('input', majCompteur);
    form.addEventListener('reset', () => requestAnimationFrame(majCompteur));
    majCompteur();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;
      if (!validate()) return;
      const key = form.dataset.key;
      if (!key) { show('info', msg('msgNokey')); return; }
      const data = new FormData(form);
      if (data.get('botcheck')) return; // robot
      const poles = data.getAll('poles').join(', ');
      data.delete('poles');
      data.set('poles', poles);
      data.set('access_key', key);
      btn.disabled = true;
      btn.setAttribute('data-envoi', '');
      label.textContent = msg('msgSending');
      try {
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) { form.reset(); show('success', msg('msgSuccess')); }
        else show('error', msg('msgError'));
      } catch {
        show('error', msg('msgError'));
      } finally {
        btn.disabled = false;
        btn.removeAttribute('data-envoi');
        label.textContent = idle;
      }
    });
    // Pendant la saisie, re-vérifie en silence les champs déjà signalés (le focus ne bouge qu'à l'envoi).
    form.querySelectorAll('input, textarea').forEach((el) => el.addEventListener('input', () => {
      if (el.getAttribute('aria-invalid') === 'true') validate(false);
    }));
  });
</script>
