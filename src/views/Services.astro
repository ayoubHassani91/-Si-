---
import { ArrowRight, Check } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Combo from '../components/home/Combo.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { t, href, POLES, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<Base lang={lang} title={d.services.metaTitle} description={d.services.metaDescription} current="services">
  <PageHero title={d.services.title} lead={d.services.lead} />
  <section class="pb-24">
    <ul class="conteneur grid gap-4 lg:grid-cols-3">
      {POLES.map((p, i) => {
        const pole = d.poles[p];
        return (
          <li class="carte flex flex-col p-8" data-pole={p} data-reveal data-reveal-delay={i * 0.08}>
            <span class="pastille self-start" data-pole={p}>{pole.verb}</span>
            <img src={`/3d/pole-${p}.webp`} alt="" width="200" height="200" loading="lazy" class="-ms-4 my-4 w-40" />
            <h2 class="titre-2">{pole.name}</h2>
            <p class="chapo mt-2">{pole.pitch}</p>
            <ul class="mt-6 space-y-2">
              {pole.services.map((s) => <li class="flex gap-2"><Check size={18} stroke-width={1.75} class="mt-1 flex-none" style="color: var(--pole)" aria-hidden="true" />{s}</li>)}
            </ul>
            <a href={href(lang, p)} class="lien mt-8 inline-flex items-center gap-2 self-start">
              {d.home.poles.more}<span class="sr-only"> : {pole.name}</span><ArrowRight size={16} stroke-width={1.75} class="fleche" aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ul>
  </section>
  <Combo lang={lang} />
  <FinalCta lang={lang} />
</Base>
