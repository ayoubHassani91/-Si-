---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; kind: 'legal' | 'privacy' }
const { lang, kind } = Astro.props;
const p = t(lang)[kind];
---
<Base lang={lang} title={p.metaTitle} current={kind}>
  <PageHero title={p.title} />
  <section class="pb-24">
    <div class="conteneur">
      <div class="max-w-[760px] space-y-10">
        {p.sections.map((s) => (
          <div>
            <h2 class="titre-3">{s.title}</h2>
            <p class="mt-3 text-encre-douce">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
