---
import { ArrowRight, CircleCheck } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Method from '../components/home/Method.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { t, href, POLES, type Lang, type PoleKey } from '../i18n';
interface Props { lang: Lang; pole: PoleKey }
const { lang, pole } = Astro.props;
const d = t(lang);
const p = d.poles[pole];
const others = POLES.filter((x) => x !== pole);
---
<Base lang={lang} title={`${p.name} · Et si (&si)`} description={p.intro} current={pole}>
  <PageHero title={p.name} lead={p.intro} pole={pole}>
    <a href={href(lang, 'contact', `?pole=${pole}`)} class="btn btn-principal mt-10">{d.services.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" /></a>
  </PageHero>

  <section class="pb-24" aria-labelledby="inclus">
    <div class="conteneur">
      <h2 id="inclus" class="titre-2" data-reveal>{d.services.includes}</h2>
      <div class="mt-10 grid gap-x-10 md:grid-cols-3">
        {p.details.map((x, i) => (
          <article class="detail" data-pole={pole} data-reveal data-reveal-delay={i * 0.08}>
            <h3 class="titre-3">{x.title}</h3>
            <p class="mt-3 text-encre-douce">{x.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="livrables" aria-labelledby="livrables">
    <div class="conteneur grid gap-10 lg:grid-cols-12">
      <h2 id="livrables" class="titre-2 lg:col-span-5">{d.services.deliverables}</h2>
      <ul class="space-y-4 lg:col-span-7">
        {p.deliverables.map((x) => (
          <li class="flex items-start gap-3 titre-3"><CircleCheck size={26} stroke-width={1.75} class="mt-0.5 flex-none" style="color: var(--pole)" data-pole={pole} aria-hidden="true" />{x}</li>
        ))}
      </ul>
    </div>
  </section>

  <Method lang={lang} />

  <section class="py-24" aria-labelledby="autres">
    <div class="conteneur">
      <h2 id="autres" class="titre-2">{d.services.otherPoles}</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {others.map((o) => (
          <li>
            <a href={href(lang, o)} class="carte autre flex items-center justify-between gap-6 p-8" data-pole={o}>
              <span>
                <span class="pastille" data-pole={o}>{d.poles[o].verb}</span>
                <span class="titre-3 mt-4 block">{d.poles[o].name}</span>
              </span>
              <ArrowRight size={24} stroke-width={1.75} class="fleche flex-none" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <FinalCta lang={lang} />
</Base>

<style>
  .detail { padding-block: 28px 8px; border-block-start: 2px solid var(--pole); }
  @media (max-width: 767px) { .detail + .detail { margin-block-start: 24px; } }
  .livrables { background: var(--color-surface); border-block: 1px solid var(--color-trait); padding-block: 96px; }
  .autre { text-decoration: none; }
  :global(html[dir="rtl"]) .fleche { transform: scaleX(-1); }
</style>
