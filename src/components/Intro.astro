---
import { t, asset, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<!-- Écran de chargement : animation du logo &si rendue dans Blender, jouée à chaque page. -->
<div class="intro" data-intro role="presentation">
  <video class="intro-video" autoplay muted playsinline preload="auto" poster={asset('/intro/intro-debut.webp')} aria-hidden="true" data-intro-video>
    <source src={asset('/intro/intro.webm')} type="video/webm" />
    <source src={asset('/intro/intro.mp4')} type="video/mp4" />
  </video>
  <span class="sr-only">{t(lang).ui.intro}</span>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--color-papier);
    pointer-events: none;
    /* Filet de sécurité : sortie automatique même si JavaScript ou la vidéo ne répondent pas. */
    animation: intro-sortie 0.55s cubic-bezier(0.7, 0, 0.2, 1) 2.4s forwards;
  }
  .intro[data-sortie] { animation: intro-sortie 0.55s cubic-bezier(0.7, 0, 0.2, 1) forwards; }
  .intro-video {
    inline-size: clamp(260px, 44vw, 520px);
    block-size: auto;
    aspect-ratio: 2 / 1;
    mix-blend-mode: darken; /* fond exactement papier */
  }
  @keyframes intro-sortie { to { transform: translateY(-100%); visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .intro { display: none; } }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-intro]');
    if (!el) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { el.remove(); return; }
    const video = el.querySelector<HTMLVideoElement>('[data-intro-video]');
    let fini = false;
    const sortir = () => {
      if (fini) return;
      fini = true;
      el.setAttribute('data-sortie', '');
      el.addEventListener('animationend', () => el.remove(), { once: true });
      setTimeout(() => el.remove(), 900);
    };
    if (video) {
      video.currentTime = 0;
      video.play().catch(() => setTimeout(sortir, 600));
      video.addEventListener('ended', () => setTimeout(sortir, 120), { once: true });
      video.addEventListener('error', () => setTimeout(sortir, 600), { once: true });
    }
    setTimeout(sortir, 2300);
  });
</script>
