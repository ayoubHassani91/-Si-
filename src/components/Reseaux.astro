---
import { t, SOCIAL, type Lang } from '../i18n';

/** Liens vers les pages LinkedIn et Instagram de l'agence. `variante` : pied (cercles), entete (discret), sombre (menu mobile). */
interface Props { lang: Lang; variante?: 'pied' | 'entete' | 'sombre'; class?: string }
const { lang, variante = 'pied', class: classe } = Astro.props;
const d = t(lang);
const taille = variante === 'entete' ? 17 : 19;
---
<ul class:list={['reseaux', `reseaux-${variante}`, classe]}>
  <li>
    <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label={d.footer.linkedin} title="LinkedIn">
      <svg viewBox="0 0 24 24" width={taille} height={taille} fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
    </a>
  </li>
  <li>
    <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label={d.footer.instagram} title="Instagram">
      <svg viewBox="0 0 24 24" width={taille} height={taille} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><path d="M17.5 6.5h.01" /></svg>
    </a>
  </li>
</ul>

<style>
  .reseaux { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .reseaux a {
    display: inline-grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 999px;
    transition: background-color 0.2s, color 0.2s;
  }
  .reseaux a:focus-visible { outline: 2px solid var(--color-corail-texte); outline-offset: 2px; }
  .reseaux-pied a { color: var(--color-encre); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-encre) 20%, transparent); }
  .reseaux-pied a:hover { background: var(--color-encre); color: var(--color-papier); }
  .reseaux-entete { gap: 0; }
  .reseaux-entete a { inline-size: 40px; block-size: 40px; color: var(--color-encre-douce); }
  .reseaux-entete a:hover { color: var(--color-encre); background: color-mix(in srgb, var(--color-encre) 6%, transparent); }
  .reseaux-sombre a { color: #a3a7b0; box-shadow: inset 0 0 0 1px #2c3038; }
  .reseaux-sombre a:hover { color: var(--color-papier); }
</style>
