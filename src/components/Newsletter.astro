---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).newsletter;
---
<section class="grid grid-cols-1 gap-8 pb-14 md:grid-cols-2 md:items-end [&>*]:min-w-0" aria-labelledby="nl-titre">
  <div>
    <h2 id="nl-titre" class="titre-2">{d.title}</h2>
    <p class="mt-3 text-encre-douce">{d.text}</p>
  </div>
  <form class="nl" data-newsletter novalidate>
    <label for="nl-email" class="etiquette text-encre-douce">{d.label}</label>
    <div class="mt-2 flex gap-2">
      <input id="nl-email" name="email" type="email" autocomplete="email" maxlength="200" placeholder={d.placeholder} required class="nl-champ" />
      <button type="submit" class="btn btn-secondaire shrink-0">{d.cta}</button>
    </div>
    <p class="mt-2 text-legende text-encre-douce" role="status" data-nl-status hidden>{d.soon}</p>
  </form>
</section>

<style>
  .nl-champ {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding-inline: 18px;
    border-radius: 999px;
    background: var(--color-papier);
    border: 1px solid var(--color-trait);
  }
  .nl-champ:focus-visible { outline: 2px solid var(--color-cobalt); outline-offset: 2px; }
</style>

<script>
  // Interface seulement : le branchement à un outil d'e-mailing se fera plus tard.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((f) => {
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        const s = f.querySelector<HTMLElement>('[data-nl-status]');
        if (s) s.hidden = false;
      });
    });
  });
</script>
