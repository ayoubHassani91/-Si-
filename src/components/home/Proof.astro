---
import { Code, Megaphone } from '@lucide/astro';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).home.proof;
const icons = [Code, Megaphone];
---
<section class="py-32" aria-labelledby="preuve-titre">
  <div class="conteneur">
    <h2 id="preuve-titre" class="titre-1 max-w-[20ch]" data-reveal>{p.title}</h2>
    <div class="mt-14 grid gap-4 md:grid-cols-12">
      {p.team.map((m, i) => {
        const Icon = icons[i];
        return (
          <article class="carte p-8 md:col-span-4" data-reveal data-reveal-delay={i * 0.08}>
            <Icon size={28} stroke-width={1.75} aria-hidden="true" />
            <h3 class="titre-3 mt-6">{m.role}</h3>
            <p class="mt-3 text-encre-douce">{m.text}</p>
          </article>
        );
      })}
      <div class="stat md:col-span-4" data-reveal data-reveal-delay="0.16">
        <p class="stat-phrase">{p.stat} {p.statLabel}.</p>
      </div>
    </div>

    <div class="mt-20">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h3 class="titre-2">{p.casesTitle}</h3>
        <p class="etiquette text-encre-douce">{p.casesNote}</p>
      </div>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {p.cases.map((c) => (
          <li class="cas" data-reveal>
            <span class="pastille" data-pole={c.pole}>{t(lang).poles[c.pole as 'logiciels'].short}</span>
            <p class="titre-3 mt-5">{c.title}</p>
            <p class="mt-3 text-encre-douce">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px;
    border-radius: var(--radius-m);
    background: var(--color-corail);
    color: var(--color-encre);
    min-block-size: 260px;
  }
  .stat-phrase {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .stat-phrase::first-letter { text-transform: uppercase; }
  .cas {
    padding: 28px;
    border-radius: var(--radius-m);
    border: 1.5px dashed color-mix(in srgb, var(--color-encre) 30%, transparent);
  }
</style>
