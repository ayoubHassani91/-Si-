---
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = t(lang).home.manifesto;
const words = m.text.split(' ');
---
<section class="manifeste" data-manifeste aria-labelledby="manifeste-titre">
  <div class="conteneur grid gap-8 lg:gap-12 lg:grid-cols-12">
    <h2 id="manifeste-titre" class="lg:col-span-7">
      {m.lines.map((l) => (
        <span class="ligne"><span class="ligne-txt">{l}</span></span>
      ))}
    </h2>
    <p class="mot-a-mot titre-3 lg:col-span-5 lg:self-end" data-mots>
      {words.map((w) => <span class="mot">{w} </span>)}
    </p>
  </div>
</section>

<style>
  .manifeste { padding-block: clamp(72px, 12vw, 128px); }
  .ligne {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  :global(html[dir="rtl"]) .ligne { letter-spacing: 0; line-height: 1.25; }
  .mot-a-mot { font-weight: 500; }
  .mot { color: #8a8d93; }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  document.addEventListener('astro:page-load', () => {
    const s = document.querySelector<HTMLElement>('[data-manifeste]');
    if (!s) return;
    const mots = s.querySelectorAll<HTMLElement>('.mot');
    const lignes = s.querySelectorAll<HTMLElement>('.ligne-txt');
    if (reduceMotion()) { gsap.set(mots, { color: 'var(--color-encre)' }); return; }
    gsap.from(lignes, {
      yPercent: 60, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.12,
      scrollTrigger: { trigger: s, start: 'top 70%', once: true },
    });
    gsap.to(mots, {
      color: '#15171c', stagger: 0.08, ease: 'none',
      scrollTrigger: { trigger: s.querySelector('[data-mots]'), start: 'top 80%', end: 'bottom 45%', scrub: true },
    });
  });
</script>
