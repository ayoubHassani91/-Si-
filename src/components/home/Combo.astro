---
import { ArrowRight } from '@lucide/astro';
import { t, href, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang).home.combo;
---
<section class="pt-16 pb-6 md:pt-28 md:pb-10" aria-labelledby="combo-titre">
  <div class="conteneur">
    <div class="combo">
      <h2 id="combo-titre" class="titre-1 max-w-[14ch]" data-reveal>{c.title}</h2>
      <div data-reveal>
        <p class="chapo max-w-[52ch] text-encre">{c.text}</p>
        <a href={href(lang, 'contact')} class="btn btn-secondaire mt-8">{c.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .combo {
    display: grid;
    gap: 40px;
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--radius-m);
    background: var(--color-sable);
    align-items: center;
  }
  @media (min-width: 900px) { .combo { grid-template-columns: 5fr 7fr; align-items: start; } }
</style>

