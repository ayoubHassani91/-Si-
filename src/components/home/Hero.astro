---
import { ArrowRight, MessageCircle } from '@lucide/astro';
import { t, href, asset, whatsappHref, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home.hero;
---
<section class="hero" data-hero>
  <!-- Arrière-plan : le & 3D, en grand, qui réagit au pointeur. -->
  <div class="fond" aria-hidden="true">
    <img class="fond-media" data-poster src={asset('/3d/hero-poster.webp')} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    <video class="fond-media" data-video muted playsinline preload="none" poster={asset('/3d/hero-poster.webp')} hidden>
      <source media="(max-width: 767px)" src={asset('/3d/hero-1080x1350.webm')} type="video/webm" />
      <source media="(max-width: 767px)" src={asset('/3d/hero-1080x1350.mp4')} type="video/mp4" />
      <source src={asset('/3d/hero-1920x1080.webm')} type="video/webm" />
      <source src={asset('/3d/hero-1920x1080.mp4')} type="video/mp4" />
    </video>
    <canvas class="fond-media" data-canvas data-base={asset('/')} hidden></canvas>
  </div>

  <div class="conteneur hero-contenu">
    <div class="hero-texte">
      <h1 class="display" data-titre>{h.title}</h1>
      <p class="chapo mt-6 max-w-[42ch]" data-hero-in>{h.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3" data-hero-in>
        <a href={href(lang, 'contact')} class="btn btn-principal" data-magnet>
          {h.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" />
        </a>
        <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="btn btn-secondaire hero-wa" data-magnet>
          <MessageCircle size={18} stroke-width={1.75} aria-hidden="true" />{d.whatsapp.label}
        </a>
      </div>
    </div>
  </div>
  <button type="button" class="sr-only" data-replay>{h.replay}</button>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--color-papier);
    min-block-size: calc(100svh - 72px);
    display: flex;
    align-items: flex-end;
  }
  .fond { position: absolute; inset: 0; }
  .fond-media { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  img.fond-media, video.fond-media { mix-blend-mode: darken; }
  .fond-media[hidden] { display: none; }
  /* Mobile : le & dans un bloc au-dessus du texte. */
  .hero { flex-direction: column; align-items: stretch; justify-content: center; }
  .fond { position: relative; block-size: 38svh; flex: none; }
  .fond-media { object-fit: cover; }
  .hero-contenu { position: relative; z-index: 1; padding-block: 8px 48px; pointer-events: none; }
  .hero-contenu :is(a, button) { pointer-events: auto; }
  .hero-texte { max-inline-size: 640px; }
  .hero-texte h1 { max-inline-size: 12ch; }
  @media (min-width: 1024px) {
    .hero { flex-direction: row; align-items: center; }
    /* Fragments et circuits couvrent toute la largeur et partent du bord de la page ;
       un voile papier calé sur le texte les efface à son approche (voir hero3d.ts), le & reste au-dessus. */
    .fond { position: absolute; inset: 0; block-size: auto; }
    img.fond-media, video.fond-media { inset-inline-start: 34%; inline-size: 66%; object-fit: contain; transform: scale(1.35); }
    .hero-texte { max-inline-size: 600px; }
    .hero-contenu { padding-block: 48px 64px; }
  }
  @media (max-width: 1023px) { .hero-wa { background: var(--color-papier); } }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  import type { HeroScene } from '../../scripts/hero3d';

  let hero: HeroScene | null = null;
  const BUILD_END = 4;

  async function init() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    if (!section) return;
    const canvas = section.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const video = section.querySelector<HTMLVideoElement>('[data-video]')!;
    const poster = section.querySelector<HTMLImageElement>('[data-poster]')!;
    const replayBtn = section.querySelector<HTMLButtonElement>('[data-replay]')!;
    const texte = section.querySelector<HTMLElement>('.hero-texte')!;
    // Zone épargnée par les fragments : une ellipse autour du bloc de texte, recalculée à chaque redimensionnement.
    const caler = () => {
      if (!hero) return;
      const s0 = section.getBoundingClientRect();
      const t0 = texte.getBoundingClientRect();
      hero.setMask(
        (t0.left + t0.width / 2 - s0.left) / s0.width,
        (t0.top + t0.height / 2 - s0.top) / s0.height,
        (t0.width / 2 + 40) / s0.width / 0.62,
        (t0.height / 2 + 32) / s0.height / 0.62,
      );
    };
    new ResizeObserver(caler).observe(section);

    if (reduceMotion()) return; // image fixe du & assemblé

    const delay = document.querySelector('[data-intro]') ? 1.6 : 0.1;
    gsap.from(section.querySelectorAll('[data-hero-in]'), { y: 16, opacity: 0, duration: 0.6, ease: 'power3.out', stagger: 0.07, delay: delay + 0.15, clearProps: 'all' });

    // Un clic sur le fond (hors liens et boutons) reconstruit le &.
    const surFond = (e: Event) => !(e.target as Element).closest('a, button');

    const mobile = matchMedia('(max-width: 767px)').matches
      || ((navigator.hardwareConcurrency ?? 8) <= 4 && matchMedia('(pointer: coarse)').matches);

    if (!mobile) {
      await new Promise<void>((r) => (document.readyState === 'complete' ? r() : addEventListener('load', () => r(), { once: true })));
      await new Promise<void>((r) => ('requestIdleCallback' in window ? requestIdleCallback(() => r(), { timeout: 1500 }) : setTimeout(r, 300)));
      const { webglAvailable, mountHero } = await import('../../scripts/hero3d');
      // La construction du & démarre une fois l'écran de chargement parti : le visiteur la voit en entier.
      await new Promise<void>((r) => {
        const t0 = performance.now();
        const attendre = () => (!document.querySelector('[data-intro]') || performance.now() - t0 > 3000 ? r() : setTimeout(attendre, 80));
        attendre();
      });
      if (webglAvailable()) {
        try {
          canvas.hidden = false;
          const rtl = document.documentElement.dir === 'rtl';
          const large = matchMedia('(min-width: 1024px)').matches;
          hero = await mountHero(canvas, { shift: large ? (rtl ? -0.24 : 0.24) : 0, masque: large });
          caler();
          poster.hidden = true;
          section.addEventListener('pointermove', (e) => {
            const r = section.getBoundingClientRect();
            const cx = r.left + r.width * (large ? (rtl ? 0.26 : 0.74) : 0.5);
            const cy = r.top + r.height / 2;
            const nx = Math.max(-1, Math.min(1, (e.clientX - cx) / (r.width / 2)));
            const ny = Math.max(-1, Math.min(1, (e.clientY - cy) / (r.height / 2)));
            hero?.point(nx, ny);
          });
          section.addEventListener('pointerleave', () => hero?.point(0, 0));
          section.addEventListener('click', (e) => { if (surFond(e)) hero?.replay(); });
          replayBtn.addEventListener('click', () => hero?.replay());
          return;
        } catch {
          canvas.hidden = true;
          hero = null;
        }
      }
    }

    // Mobile ou sans WebGL : la vidéo joue la construction ; un toucher sur le fond la rejoue.
    const play = () => {
      video.hidden = false;
      video.currentTime = 0;
      video.play().then(() => { poster.hidden = true; }).catch(() => { video.hidden = true; poster.hidden = false; });
    };
    video.addEventListener('timeupdate', () => { if (video.currentTime >= BUILD_END) video.pause(); });
    section.addEventListener('click', (e) => { if (surFond(e)) play(); });
    replayBtn.addEventListener('click', play);
    play();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { hero?.dispose(); hero = null; });
</script>
