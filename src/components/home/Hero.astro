---
import { ArrowRight, MessageCircle, MousePointerClick } from '@lucide/astro';
import { t, href, asset, whatsappHref, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home.hero;
---
<section class="hero" data-hero>
  <div class="conteneur hero-pile">
    <!-- Le & : il se construit à partir de fragments de code, suit le pointeur et se reconstruit au clic. -->
    <button type="button" class="scene" data-scene aria-label={h.replay}>
      <img class="scene-img" data-poster src={asset('/3d/hero-poster.webp')} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
      <video class="scene-img" data-video muted playsinline preload="none" poster={asset('/3d/hero-poster.webp')} hidden>
        <source media="(max-width: 767px)" src={asset('/3d/hero-1080x1350.webm')} type="video/webm" />
        <source media="(max-width: 767px)" src={asset('/3d/hero-1080x1350.mp4')} type="video/mp4" />
        <source src={asset('/3d/hero-1920x1080.webm')} type="video/webm" />
        <source src={asset('/3d/hero-1920x1080.mp4')} type="video/mp4" />
      </video>
      <canvas class="scene-img" data-canvas data-base={asset('/')} hidden></canvas>
    </button>
    <p class="indice etiquette" aria-hidden="true" data-hero-in>
      <MousePointerClick size={14} stroke-width={1.75} />
      <span class="indice-souris">{h.hintMouse}</span><span class="indice-tactile">{h.hintTouch}</span>
    </p>

    <h1 class="display mt-6" data-hero-titre>{h.title}</h1>
    <p class="chapo mx-auto mt-5 max-w-[50ch]" data-hero-in>{h.lead}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3" data-hero-in>
      <a href={href(lang, 'contact')} class="btn btn-principal" data-magnet>
        {h.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" />
      </a>
      <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="btn btn-secondaire" data-magnet>
        <MessageCircle size={18} stroke-width={1.75} aria-hidden="true" />{d.whatsapp.label}
      </a>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--color-papier); }
  .hero-pile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-block-size: calc(100svh - 72px);
    justify-content: center;
    padding-block: 16px 64px;
  }
  .hero-pile h1 { max-inline-size: 14ch; }
  .scene {
    position: relative;
    inline-size: min(100%, 720px);
    block-size: clamp(240px, 44svh, 500px);
    cursor: pointer;
    border-radius: var(--radius-m);
    -webkit-tap-highlight-color: transparent;
  }
  .scene:focus-visible { outline: 2px solid var(--color-cobalt); outline-offset: 4px; }
  .scene-img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
  /* Le fond papier des images se fond exactement dans celui de la page. */
  img.scene-img, video.scene-img { mix-blend-mode: darken; }
  .scene-img[hidden] { display: none; }
  .indice {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: 4px;
    color: var(--color-encre-douce);
  }
  .indice-tactile { display: none; }
  @media (pointer: coarse) { .indice-souris { display: none; } .indice-tactile { display: inline; } }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  import type { HeroScene } from '../../scripts/hero3d';

  let hero: HeroScene | null = null;
  const BUILD_END = 4;

  async function init() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    if (!section) return;
    const scene = section.querySelector<HTMLButtonElement>('[data-scene]')!;
    const canvas = section.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const video = section.querySelector<HTMLVideoElement>('[data-video]')!;
    const poster = section.querySelector<HTMLImageElement>('[data-poster]')!;

    if (reduceMotion()) return; // image fixe du & assemblé, sans animation

    const delay = document.querySelector('[data-intro]') ? 1.6 : 0.1;
    gsap.from(section.querySelector('[data-hero-titre]'), { y: 24, duration: 0.8, ease: 'power3.out', delay, clearProps: 'transform' });
    gsap.from(section.querySelectorAll('[data-hero-in]'), { y: 16, opacity: 0, duration: 0.6, ease: 'power3.out', stagger: 0.06, delay: delay + 0.15, clearProps: 'all' });

    const mobile = matchMedia('(max-width: 767px)').matches
      || ((navigator.hardwareConcurrency ?? 8) <= 4 && matchMedia('(pointer: coarse)').matches);

    if (!mobile) {
      // three.js n'est chargé qu'une fois la page affichée et le navigateur au repos.
      await new Promise<void>((r) => (document.readyState === 'complete' ? r() : addEventListener('load', () => r(), { once: true })));
      await new Promise<void>((r) => ('requestIdleCallback' in window ? requestIdleCallback(() => r(), { timeout: 1500 }) : setTimeout(r, 300)));
      const { webglAvailable, mountHero } = await import('../../scripts/hero3d');
      if (webglAvailable()) {
        try {
          canvas.hidden = false;
          hero = await mountHero(canvas);
          poster.hidden = true;
          // Le & suit le pointeur partout dans le haut de page.
          section.addEventListener('pointermove', (e) => {
            const r = scene.getBoundingClientRect();
            const nx = (e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2);
            const ny = (e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2);
            hero?.point(Math.max(-1, Math.min(1, nx)), Math.max(-1, Math.min(1, ny)));
          });
          section.addEventListener('pointerleave', () => hero?.point(0, 0));
          scene.addEventListener('click', () => hero?.replay());
          return;
        } catch {
          canvas.hidden = true;
          hero = null;
        }
      }
    }

    // Mobile ou sans WebGL : la vidéo joue la construction puis s'arrête sur le & ; un toucher la rejoue.
    const play = () => {
      video.hidden = false;
      video.currentTime = 0;
      video.play().then(() => { poster.hidden = true; }).catch(() => { video.hidden = true; poster.hidden = false; });
    };
    video.addEventListener('timeupdate', () => { if (video.currentTime >= BUILD_END) video.pause(); });
    scene.addEventListener('click', play);
    play();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { hero?.dispose(); hero = null; });
</script>
