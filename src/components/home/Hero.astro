---
import { ArrowRight, MessageCircle } from '@lucide/astro';
import { t, href, whatsappHref, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home.hero;
---
<section class="hero" data-hero>
  <div class="conteneur hero-grille">
    <div class="hero-texte" data-hero-texte>
      <h1 class="display">{h.title}</h1>
      <p class="chapo mt-6 max-w-[46ch]">{h.lead}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={href(lang, 'contact')} class="btn btn-principal">
          {h.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" />
        </a>
        <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="btn btn-secondaire">
          <MessageCircle size={18} stroke-width={1.75} aria-hidden="true" />{d.whatsapp.label}
        </a>
      </div>
    </div>

    <div class="hero-scene" aria-hidden="true">
      <img class="hero-poster" data-hero-poster src="/3d/hero-poster.webp" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
      <video class="hero-video" data-hero-video muted playsinline preload="none" poster="/3d/hero-poster.webp" hidden>
        <source media="(max-width: 767px)" src="/3d/hero-1080x1350.webm" type="video/webm" />
        <source media="(max-width: 767px)" src="/3d/hero-1080x1350.mp4" type="video/mp4" />
        <source src="/3d/hero-1920x1080.webm" type="video/webm" />
        <source src="/3d/hero-1920x1080.mp4" type="video/mp4" />
      </video>
      <canvas class="hero-canvas" data-hero-canvas></canvas>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--color-papier); }
  .hero-grille {
    display: grid;
    gap: 8px;
    align-items: center;
    min-block-size: calc(100svh - 72px);
    padding-block: 24px 64px;
  }
  .hero-scene { position: relative; order: -1; block-size: 36svh; }
  @media (min-width: 1024px) {
    .hero-grille { grid-template-columns: 7fr 5fr; gap: 32px; padding-block: 48px 96px; }
    .hero-scene { order: 0; block-size: min(64svh, 600px); }
  }
  .hero-canvas, .hero-video, .hero-poster {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  /* Le fond papier des images se fond exactement dans celui de la page. */
  .hero-video, .hero-poster { mix-blend-mode: darken; }
  .hero-poster[hidden], .hero-canvas[hidden] { display: none; }
  /* Sur grand écran, la 3D construit le & : l'image fixe ne sert qu'en repli. */
  @media (min-width: 768px) { .hero-poster:not([data-show]) { display: none; } }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  import type { HeroScene } from '../../scripts/hero3d';

  let hero: HeroScene | null = null;
  const BUILD_END = 4; // secondes : le & est assemblé

  async function init() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    if (!section) return;
    const canvas = section.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
    const video = section.querySelector<HTMLVideoElement>('[data-hero-video]')!;
    const poster = section.querySelector<HTMLImageElement>('[data-hero-poster]')!;
    const texte = section.querySelector<HTMLElement>('[data-hero-texte]')!;

    // Animations réduites : image fixe du & assemblé, rien d'autre.
    if (reduceMotion()) { canvas.hidden = true; poster.setAttribute('data-show', ''); return; }

    gsap.timeline({ defaults: { ease: 'power3.out' } })
      .from(texte.querySelector('h1'), { y: 24, duration: 0.8 }, 0) // pas de fondu : le titre est l'élément LCP
      .from(texte.querySelectorAll('.chapo, .btn'), { y: 16, opacity: 0, duration: 0.6, stagger: 0.06 }, 0.3);

    const mobile = matchMedia('(max-width: 767px)').matches
      || ((navigator.hardwareConcurrency ?? 8) <= 4 && matchMedia('(pointer: coarse)').matches);

    if (!mobile) {
      // three.js n'est chargé qu'une fois la page affichée et le navigateur au repos.
      await new Promise<void>((r) => (document.readyState === 'complete' ? r() : addEventListener('load', () => r(), { once: true })));
      await new Promise<void>((r) => ('requestIdleCallback' in window ? requestIdleCallback(() => r(), { timeout: 1500 }) : setTimeout(r, 300)));
      const { webglAvailable, mountHero } = await import('../../scripts/hero3d');
      if (webglAvailable()) {
        try {
          hero = await mountHero(canvas);
          poster.hidden = true;
          return;
        } catch {
          hero = null;
        }
      }
    }

    // Mobile ou sans WebGL : la vidéo joue la construction une fois, puis s'arrête sur le & assemblé.
    canvas.hidden = true;
    video.hidden = false;
    video.addEventListener('playing', () => { poster.hidden = true; }, { once: true });
    video.addEventListener('timeupdate', () => { if (video.currentTime >= BUILD_END) video.pause(); });
    video.play().catch(() => { video.hidden = true; poster.hidden = false; poster.setAttribute('data-show', ''); });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { hero?.dispose(); hero = null; });
</script>
