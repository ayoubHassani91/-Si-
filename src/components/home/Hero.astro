---
import { ArrowRight, MessageCircle } from '@lucide/astro';
import { t, href, asset, whatsappHref, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home.hero;
---
<section class="hero" data-hero>
  <!-- Le & : 3D interactive sur ordinateur, image fixe animée en CSS sur mobile (rendus Blender). -->
  <div class="fond" aria-hidden="true">
    <img class="fond-media" data-poster src={asset('/3d/logo-poster.webp')} alt="" width="912" height="514" fetchpriority="high" decoding="async" />
    <canvas class="fond-media" data-canvas data-base={asset('/')} hidden></canvas>
  </div>

  <div class="conteneur hero-contenu">
    <div class="hero-texte">
      <h1 class="display" data-titre>{h.title}</h1>
      <p class="chapo mt-6 max-w-[42ch]" data-hero-in>{h.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3" data-hero-in>
        <a href={href(lang, 'contact')} class="btn btn-principal" data-magnet>
          {h.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" />
        </a>
        <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="btn btn-secondaire hero-wa" data-magnet>
          <MessageCircle size={18} stroke-width={1.75} aria-hidden="true" />{d.whatsapp.label}
        </a>
      </div>
    </div>
  </div>
  <button type="button" class="sr-only" data-replay>{h.replay}</button>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--color-papier);
    min-block-size: calc(100svh - 72px);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
  }
  .fond { position: relative; block-size: 38svh; flex: none; }
  .fond-media { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: contain; }
  img.fond-media { mix-blend-mode: darken; }
  .fond-media[hidden] { display: none; }
  /* Entrée de l'image fixe (mobile) : le & monte et se révèle depuis le bas, sans effet superflu. */
  .fond[data-anime] img.fond-media { animation: amp-entree 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes amp-entree {
    from { clip-path: inset(100% 0 0 0); transform: translateY(8%) scale(0.94); }
    to { clip-path: inset(0 0 0 0); transform: none; }
  }
  .hero-contenu { position: relative; z-index: 1; padding-block: 8px 48px; pointer-events: none; }
  .hero-contenu :is(a, button) { pointer-events: auto; }
  .hero-texte { max-inline-size: 640px; }
  .hero-texte h1 { max-inline-size: 12ch; }
  @media (min-width: 1024px) {
    .hero { flex-direction: row; align-items: center; }
    .fond { position: absolute; inset: 0; block-size: auto; }
    img.fond-media { inset-inline-start: 50%; inline-size: 46%; }
    .hero-texte { max-inline-size: 600px; }
    .hero-contenu { padding-block: 48px 64px; }
  }
  @media (max-width: 1023px) { .hero-wa { background: var(--color-papier); } }
  @media (prefers-reduced-motion: reduce) { .fond[data-anime] img.fond-media { animation: none; } }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  import type { HeroScene } from '../../scripts/hero3d';

  let hero: HeroScene | null = null;

  // Attend que l'écran de chargement soit parti : le visiteur voit l'assemblage en entier.
  const apresIntro = () => new Promise<void>((r) => {
    const t0 = performance.now();
    const attendre = () => (!document.querySelector('[data-intro]') || performance.now() - t0 > 3000 ? r() : setTimeout(attendre, 80));
    attendre();
  });

  async function init() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    if (!section) return;
    const fond = section.querySelector<HTMLElement>('.fond')!;
    const canvas = section.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const poster = section.querySelector<HTMLImageElement>('[data-poster]')!;
    const replayBtn = section.querySelector<HTMLButtonElement>('[data-replay]')!;

    if (reduceMotion()) return; // image fixe du & assemblé

    const delay = document.querySelector('[data-intro]') ? 1.6 : 0.1;
    gsap.from(section.querySelectorAll('[data-hero-in]'), { y: 16, opacity: 0, duration: 0.6, ease: 'power3.out', stagger: 0.07, delay: delay + 0.15, clearProps: 'all' });

    // Un clic sur le fond (hors liens et boutons) rejoue l'assemblage.
    const surFond = (e: Event) => !(e.target as Element).closest('a, button');

    const mobile = matchMedia('(max-width: 767px)').matches
      || ((navigator.hardwareConcurrency ?? 8) <= 4 && matchMedia('(pointer: coarse)').matches);

    if (!mobile) {
      await new Promise<void>((r) => (document.readyState === 'complete' ? r() : addEventListener('load', () => r(), { once: true })));
      await new Promise<void>((r) => ('requestIdleCallback' in window ? requestIdleCallback(() => r(), { timeout: 1500 }) : setTimeout(r, 300)));
      const { webglAvailable, mountHero } = await import('../../scripts/hero3d');
      await apresIntro();
      if (webglAvailable()) {
        try {
          canvas.hidden = false;
          const rtl = document.documentElement.dir === 'rtl';
          // Zone libre pour le logo : de la fin du texte jusqu'au bord de la mise en page (un peu au-delà).
          const texte = section.querySelector<HTMLElement>('.hero-texte')!;
          const cadre = section.querySelector<HTMLElement>('.hero-contenu')!;
          const zone = () => {
            if (!matchMedia('(min-width: 1024px)').matches) return null;
            const c = canvas.getBoundingClientRect();
            const k = cadre.getBoundingClientRect();
            const bords = [...texte.children].map((el) => el.getBoundingClientRect());
            if (rtl) {
              const fin = Math.min(...bords.map((b) => b.left)) - 48;
              return { l: Math.max(24, k.left - 120) - c.left, r: fin - c.left };
            }
            const fin = Math.max(...bords.map((b) => b.right)) + 48;
            return { l: fin - c.left, r: Math.min(c.width - 24, k.right + 120 - c.left) };
          };
          hero = await mountHero(canvas, { zone });
          poster.hidden = true;
          // Le logo suit le curseur partout dans la fenêtre (position relative au centre du logo).
          const suivre = (e: PointerEvent) => {
            const r = canvas.getBoundingClientRect();
            const z = zone();
            const cx = r.left + (z ? (z.l + z.r) / 2 : r.width / 2);
            const cy = r.top + r.height / 2;
            const nx = Math.max(-1, Math.min(1, (e.clientX - cx) / (innerWidth * 0.4)));
            const ny = Math.max(-1, Math.min(1, (e.clientY - cy) / (innerHeight * 0.45)));
            hero?.point(nx, ny);
          };
          const recentrer = () => hero?.point(0, 0);
          addEventListener('pointermove', suivre, { passive: true });
          document.documentElement.addEventListener('pointerleave', recentrer);
          document.addEventListener('astro:before-swap', () => {
            removeEventListener('pointermove', suivre);
            document.documentElement.removeEventListener('pointerleave', recentrer);
          }, { once: true });
          section.addEventListener('click', (e) => { if (surFond(e)) hero?.replay(); });
          replayBtn.addEventListener('click', () => hero?.replay());
          return;
        } catch {
          canvas.hidden = true;
          hero = null;
        }
      }
    }

    // Mobile ou sans WebGL : l'image fixe du & se révèle ; un toucher rejoue l'entrée.
    const jouer = () => { fond.removeAttribute('data-anime'); void fond.offsetWidth; fond.setAttribute('data-anime', ''); };
    await apresIntro();
    jouer();
    section.addEventListener('click', (e) => { if (surFond(e)) jouer(); });
    replayBtn.addEventListener('click', jouer);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { hero?.dispose(); hero = null; });
</script>
