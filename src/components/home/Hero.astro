---
import { ArrowRight, MessageCircle, Check, RotateCcw } from '@lucide/astro';
import { t, href, whatsappHref, POLES, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home.hero;
const c = h.composer;
const contact = href(lang, 'contact');
---
<section class="hero" data-hero>
  <div class="conteneur hero-grille">
    <div class="hero-texte">
      <h1 class="display" data-hero-titre>{h.title}</h1>
      <p class="chapo mt-6 max-w-[46ch]" data-hero-in>{h.lead}</p>
      <div class="mt-9 flex flex-wrap gap-3" data-hero-in>
        <a href={contact} class="btn btn-principal" data-magnet>
          {h.cta}<ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" />
        </a>
        <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="btn btn-secondaire" data-magnet>
          <MessageCircle size={18} stroke-width={1.75} aria-hidden="true" />{d.whatsapp.label}
        </a>
      </div>
    </div>

    <!-- Configurateur : le visiteur compose son projet et part vers le devis avec sa sélection. -->
    <form class="compo" action={contact} method="get" data-compo
      data-empty={c.empty} data-one={c.one} data-many={c.many} data-poles-one={c.polesOne} data-poles-many={c.polesMany}
      data-single={c.single} data-cta={c.cta} data-cta-empty={c.ctaEmpty}>
      <h2 class="titre-3" data-hero-in>{c.title}</h2>
      <p class="mt-2 text-encre-douce" data-hero-in>{c.hint}</p>

      <div class="mt-6 space-y-5">
        {POLES.map((p) => (
          <fieldset class="groupe" data-pole={p} data-hero-in>
            <legend class="groupe-titre"><span class="point" aria-hidden="true"></span>{d.poles[p].name}</legend>
            <div class="puces">
              {d.poles[p].services.map((s) => (
                <label class="puce">
                  <input type="checkbox" name="services" value={s} data-pole-key={p} />
                  <span><Check size={16} stroke-width={1.75} aria-hidden="true" class="coche" />{s}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
      </div>

      <div class="resume" data-hero-in>
        <div class="jauge" aria-hidden="true">
          {POLES.map((p) => <span class="segment" data-pole={p} data-seg={p}></span>)}
        </div>
        <p class="resume-texte" role="status" aria-live="polite" data-resume>{c.empty}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="submit" class="btn btn-secondaire" data-compo-cta data-magnet>
            <span data-compo-label>{c.ctaEmpty}</span><ArrowRight size={18} stroke-width={1.75} class="fleche" aria-hidden="true" />
          </button>
          <button type="reset" class="lien-reset" data-compo-reset hidden>
            <RotateCcw size={15} stroke-width={1.75} aria-hidden="true" />{c.reset}
          </button>
        </div>
      </div>
    </form>
  </div>
</section>

<style>
  .hero { background: var(--color-papier); }
  .hero-grille {
    display: grid;
    gap: 40px;
    align-items: center;
    padding-block: 40px 72px;
  }
  @media (min-width: 1024px) {
    .hero-grille { grid-template-columns: 6fr 5fr; gap: 64px; min-block-size: calc(100svh - 72px); padding-block: 48px 80px; }
  }

  .compo {
    background: var(--color-surface);
    border: 1px solid var(--color-trait);
    border-radius: var(--radius-m);
    padding: clamp(20px, 3vw, 32px);
  }
  .groupe { border: 0; margin: 0; padding: 0; min-width: 0; }
  .groupe-titre {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-block-end: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-encre-douce);
  }
  .point { inline-size: 8px; block-size: 8px; border-radius: 2px; background: var(--pole); }
  .puces { display: flex; flex-wrap: wrap; gap: 8px; }
  .puce { position: relative; cursor: pointer; }
  .puce input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
  .puce span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 44px;
    padding-inline: 14px;
    border-radius: var(--radius-s);
    border: 1px solid var(--color-trait);
    background: var(--color-papier);
    font-size: 15px;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.15s var(--ease-sortie);
  }
  .puce .coche { inline-size: 0; opacity: 0; transition: inline-size 0.2s var(--ease-sortie), opacity 0.2s; }
  .puce:hover span { border-color: var(--color-encre); }
  .puce input:active + span { transform: scale(0.97); }
  .puce input:checked + span { background: var(--color-encre); border-color: var(--color-encre); color: var(--color-papier); }
  .puce input:checked + span .coche { inline-size: 16px; opacity: 1; color: var(--pole); }
  .groupe[data-pole="logiciels"] .puce input:checked + span .coche { color: #8c9bff; }
  .groupe[data-pole="conseil"] .puce input:checked + span .coche { color: #4fbfa6; }
  .puce input:focus-visible + span { outline: 2px solid var(--color-cobalt); outline-offset: 2px; }

  .resume { margin-block-start: 24px; padding-block-start: 20px; border-block-start: 1px solid var(--color-trait); }
  .jauge { display: flex; gap: 4px; block-size: 6px; }
  .segment {
    flex: 1;
    border-radius: 2px;
    background: var(--color-trait);
    position: relative;
    overflow: hidden;
  }
  .segment::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--pole);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
    transition: transform 0.35s var(--ease-sortie);
  }
  :global(html[dir="rtl"]) .segment::after { transform-origin: right; }
  .resume-texte { margin-block-start: 12px; font-weight: 500; min-block-size: 26px; }
  .compo[data-actif] [data-compo-cta] { background: var(--color-corail); color: var(--color-encre); box-shadow: none; }
  .lien-reset {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 44px;
    padding-inline: 8px;
    color: var(--color-encre-douce);
    font-size: 14px;
    cursor: pointer;
  }
  .lien-reset:hover { color: var(--color-encre); }
  .lien-reset[hidden] { display: none; }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';

  function init() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    if (!section) return;
    const form = section.querySelector<HTMLFormElement>('[data-compo]')!;
    const ds = form.dataset;
    const resume = form.querySelector<HTMLElement>('[data-resume]')!;
    const label = form.querySelector<HTMLElement>('[data-compo-label]')!;
    const reset = form.querySelector<HTMLButtonElement>('[data-compo-reset]')!;
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="services"]')];

    const update = () => {
      const chosen = boxes.filter((b) => b.checked);
      const poles = new Set(chosen.map((b) => b.dataset.poleKey));
      form.toggleAttribute('data-actif', chosen.length > 0);
      reset.hidden = chosen.length === 0;
      label.textContent = chosen.length ? ds.cta! : ds.ctaEmpty!;
      form.querySelectorAll<HTMLElement>('[data-seg]').forEach((seg) => {
        const all = boxes.filter((b) => b.dataset.poleKey === seg.dataset.seg);
        seg.style.setProperty('--fill', String(all.filter((b) => b.checked).length / all.length));
      });
      if (!chosen.length) { resume.textContent = ds.empty!; return; }
      const n = chosen.length === 1 ? ds.one! : ds.many!.replace('{n}', String(chosen.length));
      const p = poles.size === 1 ? ds.polesOne! : ds.polesMany!.replace('{n}', String(poles.size));
      resume.textContent = `${n} · ${p} · ${ds.single}`;
    };
    form.addEventListener('change', update);
    form.addEventListener('reset', () => requestAnimationFrame(update));

    // Envoi : on part vers la page Contact avec la sélection dans l'adresse (?services=…).
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const chosen = boxes.filter((b) => b.checked);
      const url = new URL(form.action, location.href);
      if (chosen.length) {
        url.searchParams.set('services', chosen.map((b) => b.value).join('|'));
        url.searchParams.set('poles', [...new Set(chosen.map((b) => b.dataset.poleKey))].join(','));
      }
      location.href = url.toString();
    });
    update();

    if (reduceMotion()) return;
    const delay = document.querySelector('[data-intro]') ? 0.9 : 0.1;
    gsap.from(section.querySelector('[data-hero-titre]'), { y: 24, duration: 0.8, ease: 'power3.out', delay, clearProps: 'transform' });
    gsap.from(section.querySelectorAll('[data-hero-in]'), {
      y: 18, opacity: 0, duration: 0.6, ease: 'power3.out', stagger: 0.05, delay, clearProps: 'all',
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
