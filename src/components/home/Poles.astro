---
import { ArrowRight, Check } from '@lucide/astro';
import { t, href, POLES, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="poles" aria-labelledby="poles-titre">
  <div class="conteneur">
    <div class="poles-tete">
      <h2 id="poles-titre" class="titre-1 max-w-[18ch]" data-reveal>{d.home.poles.title}</h2>
      <p class="chapo max-w-[40ch]" data-reveal>{d.home.poles.lead}</p>
    </div>
    <ul class="grid gap-4 lg:grid-cols-3">
      {POLES.map((p, i) => {
        const pole = d.poles[p];
        return (
          <li class="panneau carte" data-pole={p} data-reveal data-reveal-delay={i * 0.06}>
            <span class="pastille self-start" data-pole={p}>{pole.verb}</span>
            <img src={`/3d/pole-${p}.webp`} alt="" width="280" height="280" loading="lazy" class="panneau-icone" />
            <h3 class="titre-2">{pole.name}</h3>
            <p class="chapo mt-2">{pole.pitch}</p>
            <ul class="mt-6 space-y-2">
              {pole.services.map((s) => (
                <li class="flex items-center gap-2"><Check size={18} stroke-width={1.75} aria-hidden="true" class="coche" />{s}</li>
              ))}
            </ul>
            <a href={href(lang, p)} class="lien mt-auto inline-flex items-center gap-2 self-start pt-8">
              {d.home.poles.more}<span class="sr-only"> : {pole.name}</span><ArrowRight size={16} stroke-width={1.75} class="fleche" aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .poles { padding-block: 112px; }
  .poles-tete {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-block-end: 48px;
  }
  .panneau { display: flex; flex-direction: column; padding: 32px; }
  .panneau-icone { inline-size: 160px; block-size: auto; margin-block: 12px 4px; margin-inline-start: -16px; }
  .coche { color: var(--pole); flex: none; }
</style>
